# Build-time configuration, read by assets/js/shared/config/index.js.
# Copy to .env.local for local overrides (ignored by git). Every value has a
# default; set only what differs.

# The site's domain: shown on encrypted files' placeholder, used in links.
VITE_DOMAIN=jellyjump.voidall.com

# Where the site lives, if not https://$VITE_DOMAIN. Watch Party links use it.
# VITE_BASE_URL=https://jellyjump.voidall.com

# The video added to an empty playlist on a first visit, relative to the page
# (empty for none), and the hosts that carry it (comma-separated).
VITE_SAMPLE_VIDEO_PATH=homepage.mp4
# VITE_SAMPLE_VIDEO_HOSTS=localhost,jebin2.github.io,www.voidall.com,jellyjump.voidall.com

# Feature switches (true/false).
VITE_FLAG_SAMPLE_VIDEO=true

# Set by the build; override only to test. VITE_BUILD_ID defaults to the
# commit, VITE_APP_VERSION to package.json's version.
# VITE_BUILD_ID=
# VITE_APP_VERSION=
