{
  "$schema": "Pacing presets for video timing and rhythm",

  "slow": {
    "name": "Slow / Relaxed",
    "description": "Calm, contemplative pace. Best for luxury, wellness, meditation, or high-end brands.",
    "wordsPerSecond": 2.0,
    "pauseBetweenSentences": 0.8,
    "sceneHoldTime": 1.5,

    "transitions": {
      "type": "crossfade",
      "duration": 0.8,
      "easing": "easeInOut"
    },

    "textAnimation": {
      "entranceDelay": 0.4,
      "staggerDelay": 0.25,
      "holdAfterEntrance": 0.5
    },

    "spring": {
      "damping": 25,
      "stiffness": 60,
      "mass": 1.2
    },

    "voiceover": {
      "character": "calm",
      "stability": 0.8,
      "similarity": 0.85,
      "style": 0.05
    },

    "music": {
      "bpmRange": [60, 90],
      "mood": ["calm", "ambient", "peaceful", "elegant"]
    },

    "bestFor": [
      "Luxury brands",
      "Wellness/spa",
      "Meditation apps",
      "High-end products",
      "Real estate",
      "Financial services"
    ]
  },

