{
  "$schema": "Format presets for different platforms and content types",

  "video": {
    "instagram-reel": {
      "name": "Instagram Reel",
      "platform": "instagram",
      "width": 1080,
      "height": 1920,
      "aspectRatio": "9:16",
      "fps": 30,
      "codec": "h264",
      "audioCodec": "aac",
      "audioBitrate": "192k",
      "durations": {
        "short": { "seconds": 15, "description": "Quick hook, single message" },
        "standard": { "seconds": 30, "description": "Full ad with problem-solution" },
        "long": { "seconds": 60, "description": "Detailed story or tutorial" }
      },
      "safeZones": {
        "top": 285,
        "bottom": 400,
        "left": 80,
        "right": 120
      },
      "notes": "Most engagement at 15-30s. Vertical format, sound-on preferred."
    },

    "instagram-story": {
      "name": "Instagram Story",
      "platform": "instagram",
      "width": 1080,
      "height": 1920,
      "aspectRatio": "9:16",
      "fps": 30,
      "codec": "h264",
      "audioCodec": "aac",
      "audioBitrate": "192k",
      "durations": {
        "single": { "seconds": 15, "description": "Single story segment" }
      },
      "safeZones": {
        "top": 250,
        "bottom": 300,
        "left": 60,
        "right": 60
      },
      "notes": "Ephemeral content, 24-hour visibility. Swipe-up CTA available for 10k+ followers."
    },

    "tiktok": {
      "name": "TikTok",
      "platform": "tiktok",
      "width": 1080,
      "height": 1920,
      "aspectRatio": "9:16",
      "fps": 30,
      "codec": "h264",
      "audioCodec": "aac",
      "audioBitrate": "192k",
      "durations": {
        "short": { "seconds": 15, "description": "Snappy, hook-focused" },
        "standard": { "seconds": 30, "description": "Standard ad length" },
        "medium": { "seconds": 60, "description": "More detailed content" },
        "long": { "seconds": 180, "description": "Extended storytelling" }
      },
      "safeZones": {
        "top": 150,
        "bottom": 500,
        "left": 60,
        "right": 100
      },
      "notes": "Fast-paced, trend-driven. Sound essential. First 3 seconds critical for retention."
    },

    "youtube-short": {
      "name": "YouTube Short",
      "platform": "youtube",
      "width": 1080,
      "height": 1920,
      "aspectRatio": "9:16",
      "fps": 30,
      "codec": "h264",
      "audioCodec": "aac",
      "audioBitrate": "192k",
      "durations": {
        "short": { "seconds": 15, "description": "Quick tip or hook" },
        "standard": { "seconds": 30, "description": "Standard short" },
        "max": { "seconds": 60, "description": "Maximum short length" }
      },
      "safeZones": {
        "top": 200,
        "bottom": 350,
        "left": 60,
        "right": 60
      },
      "notes": "Loops automatically. Good for educational/how-to content."
    },

    "facebook-reel": {
      "name": "Facebook Reel",
      "platform": "facebook",
      "width": 1080,
      "height": 1920,
      "aspectRatio": "9:16",
      "fps": 30,
      "codec": "h264",
      "audioCodec": "aac",
      "audioBitrate": "192k",
      "durations": {
        "short": { "seconds": 15, "description": "Quick content" },
        "standard": { "seconds": 30, "description": "Standard reel" },
        "long": { "seconds": 90, "description": "Extended content" }
      },
      "safeZones": {
        "top": 250,
        "bottom": 400,
        "left": 80,
        "right": 80
      },
      "notes": "Similar to Instagram Reels. Cross-posting supported."
    },

    "linkedin-video": {
      "name": "LinkedIn Video",
      "platform": "linkedin",
      "width": 1080,
      "height": 1920,
      "aspectRatio": "9:16",
      "fps": 30,
      "codec": "h264",
      "audioCodec": "aac",
      "audioBitrate": "192k",
      "durations": {
        "short": { "seconds": 30, "description": "Quick professional tip" },
        "standard": { "seconds": 60, "description": "Thought leadership" },
        "long": { "seconds": 120, "description": "In-depth content" }
      },
      "safeZones": {
        "top": 200,
        "bottom": 300,
        "left": 60,
        "right": 60
      },
      "notes": "Professional tone. Captions essential (often watched muted)."
    }
  },

  "carousel": {
    "instagram-carousel": {
      "name": "Instagram Carousel",
      "platform": "instagram",
      "width": 1080,
      "height": 1350,
      "aspectRatio": "4:5",
      "format": "png",
      "slides": {
        "min": 2,
        "max": 10,
        "recommended": 5
      },
      "safeZones": {
        "top": 80,
        "bottom": 80,
        "left": 80,
        "right": 80
      },
      "notes": "Swipe-through format. First slide is hook. Last slide is CTA."
    },

    "instagram-carousel-square": {
      "name": "Instagram Carousel (Square)",
      "platform": "instagram",
      "width": 1080,
      "height": 1080,
      "aspectRatio": "1:1",
      "format": "png",
      "slides": {
        "min": 2,
        "max": 10,
        "recommended": 5
      },
      "safeZones": {
        "top": 60,
        "bottom": 60,
        "left": 60,
        "right": 60
      },
      "notes": "Square format for consistent grid appearance."
    },

    "linkedin-carousel": {
      "name": "LinkedIn Carousel (PDF)",
      "platform": "linkedin",
      "width": 1080,
      "height": 1080,
      "aspectRatio": "1:1",
      "format": "pdf",
      "slides": {
        "min": 2,
        "max": 300,
        "recommended": 10
      },
      "safeZones": {
        "top": 60,
        "bottom": 60,
        "left": 60,
        "right": 60
      },
      "notes": "Document/PDF carousel. Professional educational content."
    }
  },

  "static": {
    "instagram-post": {
      "name": "Instagram Post",
      "platform": "instagram",
      "width": 1080,
      "height": 1350,
      "aspectRatio": "4:5",
      "format": "png",
      "notes": "Single image post. 4:5 gets most screen real estate in feed."
    },

    "instagram-post-square": {
      "name": "Instagram Post (Square)",
      "platform": "instagram",
      "width": 1080,
      "height": 1080,
      "aspectRatio": "1:1",
      "format": "png",
      "notes": "Classic square format."
    },

    "facebook-post": {
      "name": "Facebook Post",
      "platform": "facebook",
      "width": 1200,
      "height": 630,
      "aspectRatio": "1.91:1",
      "format": "png",
      "notes": "Landscape format optimized for Facebook feed."
    }
  }
}
